{
  "manifest_version": 3,
  "name": "Site Blocker",
  "version": "1.0.0",
  "description": "Block distracting websites with one switch.",
  "permissions": ["alarms", "declarativeNetRequest", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Site Blocker",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/on-16.png",
      "32": "icons/on-32.png",
      "48": "icons/on-48.png",
      "128": "icons/on-128.png"
    }
  },
  "icons": {
    "16": "icons/on-16.png",
    "32": "icons/on-32.png",
    "48": "icons/on-48.png",
    "128": "icons/on-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["src/blocked.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
